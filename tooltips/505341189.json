  "text": {
    "en": {
      "text": "Passively refills 1 round every 5 seconds. Firing resets this timer. \n\nReloading greatly increases this rate and scales with your reload speed, similar to venting Heat Weapons. ",
      "updatedAt": "2026-01-07T21:27:50.524Z",
      "updatedBy": "Hawkmoona"
    }
  },
