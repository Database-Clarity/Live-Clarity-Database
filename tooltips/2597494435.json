  "text": {
    "en": {
      "text": "Weapon Kills grant a stack of 'Frame of Reference' for 8 seconds. Maximum of 5 stacks.\n\n'Frame of Reference' timer is paused while stowed. Remaining duration is rounded up to a whole number of seconds.\n\n'Frame of Reference' benefits at 1|2|3|4|5 stacks:\n• 1.45%|2.8%|4.2%|5.6%|7% increased weapon damage\n• ?|?|?|?|? Range\n• ?|?|?|?|? Reload Speed",
      "updatedAt": "2025-07-29T22:35:04.965Z",
      "updatedBy": "Stardust"
    }
  },
