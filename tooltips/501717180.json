  "text": {
    "en": {
      "text": "Breaking an elemental shield matching the currently selected element <title refills [G_refill] /> the magazine from reserves and grants 5 shots of 'Ionic Return'.\n\nIonic Return grants each shot the following benefits:\n• 15% increased bodyshot damage\n• 37% increases critical damage",
      "updatedAt": "2026-01-16T23:01:46.851Z",
      "updatedBy": "Hawkmoona"
    }
  },
