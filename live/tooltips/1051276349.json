  "text": {
    "en": {
      "text": "Increases the number of <solar/>Scorch Stacks you apply to targets by 50% in MOST cases.\n\nAlways rounds up: 3 <arrow/> 4.5 <arrow/> 5\n\nSpecific increases from <solar/>Ember of Ashes for <solar/>Scorch sources can be found in their descriptions.",
      "updatedAt": "2024-08-11T18:44:23.096Z",
      "updatedBy": "Stardust"
    }
  },
  "associated": [],
