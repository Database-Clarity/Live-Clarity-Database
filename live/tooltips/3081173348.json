  "text": {
    "en": {
      "text": "Hold [Reload] to cycle this weapon's element between <arc/>Arc, <solar/>Solar, and <void/>Void. Selected element persists through stow and death.\n\nGrants <pve 30% /> <pvp [10%] /> increased damage for 11 seconds upon receiving or applying an elemental buff or debuff that matches the currently selected element. \n\nBuff can be activated while stowed.",
      "updatedAt": "2026-11-20T00:08:54.606Z",
      "updatedBy": "StardustD2"
    }
  },
