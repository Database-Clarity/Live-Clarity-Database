  "text": {
    "en": {
      "text": "20 Direct Hits on a target within 1 second of each other applies <strand/>Sever for 10 seconds (15 seconds with <strand/>Thread of Continuity) and grants you <strand/>Woven Mail for 10 seconds.",
      "updatedAt": "2026-01-18T20:26:33.529Z",
      "updatedBy": "Hawkmoona"
    }
  },
  "associated": [],
