  "text": {
    "en": {
      "text": "<solar/>Firesprite pickups grant <solar/>Restoration x1 for 2 seconds (3 with <solar/>Ember of Solace). Extends <solar/>Restoration's duration by the same amount if it's already active.\n\nCollecting a <solar/>Firesprite while <solar/>Restoration's timer is above 15 seconds will lower it back down to 15 seconds.\n\nReviving allies grants you and allies within ? meters <solar/>Restoration x1 for 5 seconds (7.5 with <solar/>Ember of Solace).",
      "updatedAt": "2024-06-04T21:30:06.899Z",
      "updatedBy": "Stardust"
    }
  },
