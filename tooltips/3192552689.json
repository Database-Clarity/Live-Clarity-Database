  "text": {
    "en": {
      "text": "Scoring multiple Precision Hits within 2 seconds of each applies <strand/>Sever to enemies within ? meters of the target.\n\nFurther hits are not counted for 4 seconds after an activation.\n\nActivation Progress per Precision Hit:\n• Slug Shotguns: 50%\n• Bows, Sniper Rifles: 34%\n• Hand Cannons, Scout Rifles: 25%\n• Sidearms: 20%\n• Auto Rifles: 15%\n• Machine Guns, Pulse Rifles: 12%\n• Submachine Guns, Trace Rifles: 10%",
      "updatedAt": "2024-01-02T13:04:49.280Z",
      "updatedBy": "Stardust"
    }
  },
  "associated": [],
