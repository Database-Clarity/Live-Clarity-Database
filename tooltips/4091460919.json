  "text": {
    "en": {
      "text": "After not having exchanged damage for 1 second:\nGrants 20 Handling, 40 Reload Speed, and 5% decreased Reload Animation Duration. Swords receive up to a 12.5% increase to Movement Speed instead.\n\nAfter not having exchanged damage for 2 seconds:\nGrants 20 Handling, 40 Reload Speed, and a 5% decresed Reload Duration. Swords receive up to a 25% increase to Movement Speed instead.\n\nCan activate while stowed.\n\nExchanging damage refers to either dealing or receiving damage. Self-damage and environmental damage do not count.",
      "updatedAt": "2026-11-11T22:42:23.000Z",
      "updatedBy": "StardustD2"
    }
  },
